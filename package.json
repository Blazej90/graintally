{
  "name": "graintally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silnik przeliczania cen skupu zbóż (rzepak, pszenica, żyto, pszenżyto, kukurydza) na podstawie cenników skupujących.",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "example": "tsx src/examples/example.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run lint && pnpm run build && pnpm run test && pnpm run test:e2e"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "pdfmake": "^0.3.11",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
