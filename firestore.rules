rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TODO (faza 3 roadmapy): to na razie blokuje wszystko. Po dodaniu Firebase
    // Auth podmień na regułę wymagającą zalogowania, np.:
    //
    // match /transactions/{doc} {
    //   allow read, write: if request.auth != null;
    // }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
